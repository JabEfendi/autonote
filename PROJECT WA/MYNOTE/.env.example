NODE_ENV=development
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=mynote
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_POOL_MAX=10
AUTH_DIR=./auth/baileys
REPORTS_DIR=./reports
TIMEZONE=Asia/Jakarta
ALLOWED_GROUP_IDS=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_INTERVAL_MS=1500
WEB_HOST=127.0.0.1
WEB_PORT=3000
# Stop waiting for QR pairing after this long (ms). 15000-600000.
WHATSAPP_PAIRING_TIMEOUT_MS=120000
# Process messages sent by the bot's own account. Keep false in production.
WHATSAPP_PROCESS_FROM_ME=false
DEFAULT_CURRENCY=IDR
LOG_MESSAGE_CONTENT=false
VOICE_ENABLED=false
VOICE_PYTHON=python
VOICE_SCRIPT=./scripts/voice-worker.py
VOICE_MODEL=large-v3-turbo
VOICE_LANGUAGE=id
VOICE_DEVICE=cpu
VOICE_COMPUTE_TYPE=int8
VOICE_TIMEOUT_MS=600000
# Optional vocabulary hints for Indonesian. Set empty to disable.
VOICE_INITIAL_PROMPT=Catatan bengkel dan garasi. Plat nomor, oli mesin, setoran, borongan, parkir, bengkel. Nominal ditulis angka rupiah.
VOICE_HOTWORDS=oli mesin, borongan, setoran, parkir, bengkel, plat nomor, pompa solar, besi pipa, BPJS, fee makelar
